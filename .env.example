# ─── Database ────────────────────────────────────────────────────────────────
# When running via docker compose the host must be "postgres" (service name).
# For local development without Docker use localhost.
DATABASE_URL="postgresql://postgres:<password>@postgres:5432/designers_room?schema=public"
# Optional direct database URL for Prisma migrations. For Prisma Postgres,
# use the direct connection string from Prisma Console instead of the pooled URL.
DIRECT_DATABASE_URL=""

# Password used by docker compose to initialise the postgres service.
POSTGRES_PASSWORD=<strong-random-secret>

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=<strong-random-secret>
OAUTH_STATE_SECRET=<another-strong-random-secret>
REFRESH_TOKEN_SECRET=<third-strong-random-secret>
CRON_SECRET=<strong-random-secret>

# Google OAuth web-client credentials. Register this exact callback URL in
# Google Cloud Console under Authorized redirect URIs.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Google account that receives ADMIN role on first sign-in.
ADMIN_EMAIL=admin@example.com

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (no trailing slash).
# Example: https://app.example.com,https://staging.example.com
CORS_ORIGINS=http://localhost:5173

# SameSite policy for the refresh cookie: strict | lax | none.
# Use "none" when the API and the frontend are served from different sites
# (cross-site calls drop a SameSite=Strict cookie); "none" always requires
# HTTPS. Leave unset to use "strict" locally and "none" in production.
#COOKIE_SAMESITE=none

# Number of reverse proxies in front of the app. On Vercel the effective value
# is never below 1 (the Vercel router) so client IPs and HTTPS detection work —
# required for Google OAuth state cookies and per-client rate limiting. Use 2
# when the Cloudflare proxy is enabled in front of the Vercel domain.
TRUST_PROXY=0

# Web application URL used after Google OAuth redirects.
WEB_APP_URL=http://localhost:5173

# ─── Cloudflare R2 (guidebook Markdown files) ─────────────────────────────────
# Create the bucket in Cloudflare Dashboard → R2, then generate an API token
# with "Object Read & Write" for that bucket. All four values are required
# before the guidebook upload/read endpoints work.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=<r2-bucket-name>

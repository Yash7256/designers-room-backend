generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  googleId          String?   @unique
  name              String
  role              Role      @default(USER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessionsRevokedAt DateTime?

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  roadmaps      Roadmap[]
  topicProgress TopicProgress[]
  attempts      Attempt[]
  xpLedger      XpLedger[]
  weeklyScores  WeeklyScore[]
  userBadges    UserBadge[]
  userStreak    UserStreak?
}

model Roadmap {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique
  position    Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topics      Topic[]
  stages      Stage[]
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([position])
}

model Stage {
  id                String       @id @default(cuid())
  position          Int
  title             String
  subtitle          String?
  byTheEnd          String?
  weekLabel         String?
  prerequisiteStage Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  roadmapId         String
  roadmap           Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  checkpoints       Checkpoint[]

  @@unique([roadmapId, position])
  @@index([roadmapId, position])
}

model Checkpoint {
  id           String   @id @default(cuid())
  position     Int      @default(0)
  task         String
  timeEstimate String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stageId      String
  stage        Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId, position])
}

model Topic {
  id               String          @id @default(cuid())
  title            String
  slug             String?
  description      String?
  position         Int             @default(0)
  stage            Int?
  difficulty       String?
  estimatedMinutes Int?
  objectKey        String?         @unique
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  roadmapId        String
  roadmap          Roadmap         @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  progress         TopicProgress[]
  document         TopicDocument?

  @@unique([roadmapId, position])
  @@unique([roadmapId, slug])
  @@index([roadmapId, position])
}

model TopicProgress {
  id        String   @id @default(cuid())
  status    String   @default("not-started")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

model TopicDocument {
  topicId     String   @id
  body        String
  contentType String   @default("text/markdown; charset=utf-8")
  sizeBytes   Int
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  familyId        String
  familyCreatedAt DateTime
  absoluteExpiry  DateTime
  replacedBy      String?
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())

  @@index([createdAt, id])
}


enum WeekStatus {
  DRAFT
  SCHEDULED
  LIVE
  ARCHIVED
}

enum ChallengeType {
  SPOT_ISSUE
  MCQ
  SHORT_ANSWER
  CRITIQUE
  FIX_IN_WORDS
  SCENARIO
  ORDERING
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
  FAILED_GRADING
}

enum GradeMethod {
  AUTO
  AI
}

model Week {
  id        String     @id @default(cuid())
  number    Int        @unique
  theme     String
  startsAt  DateTime
  endsAt    DateTime
  status    WeekStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  challenges   Challenge[]
  xpLedger     XpLedger[]
  weeklyScores WeeklyScore[]
}

model Challenge {
  id           String          @id @default(cuid())
  weekId       String
  week         Week            @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNumber    Int
  type         ChallengeType
  title        String
  brief        String
  imageUrls    String[]        @default([])
  payload      Json?
  answerKey    Json?
  rubricId     String?
  rubric       Rubric?         @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  maxXp        Int             @default(100)
  difficulty   String?
  status       ChallengeStatus @default(DRAFT)
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  attempts Attempt[]

  @@unique([weekId, dayNumber])
  @@index([weekId, dayNumber])
}

model Rubric {
  id        String   @id @default(cuid())
  name      String
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenges Challenge[]
}

model Attempt {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId      String
  challenge        Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeVersion Int
  status           AttemptStatus @default(IN_PROGRESS)
  answer           Json?
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  gradedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  grade     Grade?
  xpLedgers XpLedger[]

  @@unique([userId, challengeId])
  @@index([userId, status])
}

model Grade {
  id        String      @id @default(cuid())
  attemptId String      @unique
  attempt   Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  method    GradeMethod
  scores    Json
  totalScore Int
  feedback  String?
  modelInfo Json?
  createdAt DateTime    @default(now())
}

model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  weekId    String
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  points    Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([weekId])
}

model WeeklyScore {
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId         String
  week           Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  totalXp        Int      @default(0)
  completedCount Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@id([userId, weekId])
  @@index([weekId, totalXp(sort: Desc)])
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  criteria    Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model UserStreak {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  current        Int      @default(0)
  longest        Int      @default(0)
  lastActiveDate DateTime?
  updatedAt      DateTime @updatedAt
}

